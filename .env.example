# Copy to .env.local and fill in real values. Never commit .env.local.

# Gemini (required for /api/plan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Market data: demo | live | yahoo | polygon
MARKET_DATA_PROVIDER=demo
POLYGON_API_KEY=

# Neon Postgres (pooled / serverless URL preferred for the app)
DATABASE_URL=

# Optional: non-pooled Neon URL for drizzle-kit migrations
# DIRECT_URL=

# Auth.js (Google OAuth)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
